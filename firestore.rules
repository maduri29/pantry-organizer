rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function member(household) {
   let members = get(/databases/$(database)/documents/households/$(household)).data.memberUids;
   return request.auth != null && members is list && members.size() >= 1 && members.size() <= 2
    && members[0] is string
    && (members.size() == 1 || (members[1] is string && members[0] != members[1]))
    && request.auth.uid in members;
  }
  match /households/{household} {
   allow read: if member(household);
   // Membership is provisioned by the project owner in the console, never by clients.
   allow write: if false;
   match /inventory/current {
    allow read: if member(household);
    function valid() {
     let d=request.resource.data;
     return d.keys().hasOnly(['state','revision']) && d.revision is int && d.revision >= 1
      && d.state.keys().hasAll(['products','batches','movements','shopping'])
      && d.state.keys().hasOnly(['products','batches','movements','shopping'])
      && d.state.products is list && d.state.batches is list
      && d.state.movements is list && d.state.shopping is list
      && d.state.products.size() <= 500 && d.state.batches.size() <= 2000
      && d.state.movements.size() <= 5000 && d.state.shopping.size() <= 2000;
    }
    allow create: if member(household) && valid() && request.resource.data.revision == 1;
    allow update: if member(household) && valid() && request.resource.data.revision == resource.data.revision + 1;
    allow delete: if false;
   }
  }
 }
}
