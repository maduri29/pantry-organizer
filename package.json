{
  "name": "pantry-organizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "bun server.mjs",
    "preview": "bun server.mjs",
    "bundle": "bun build.mjs --bundle-only",
    "build": "bun build.mjs",
    "search": "tgrep --no-index",
    "ci": "bun run check && bun run test",
    "test": "node --test tests/domain.test.mjs && bun test tests/domain.test.mjs",
    "test:ui": "node tests/ui.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "check": "oxlint && oxfmt --check && tsc --noEmit && node --check server.mjs && node --check build.mjs && node --check src/app.js && node --check src/domain.js && node --check src/storage.js && node --check src/firebase.js"
  },
  "dependencies": {
    "effect": "^3.22.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
